[
  {
    "pattern": "/",
    "html": "/index.html",
    "modules": [
      "/assets/routes/index.js",
      "/assets/lib/components/card/card.js",
      "/assets/lib/components/counter/counter.js",
      "/assets/lib/state/cart.js",
      "/assets/core/router.js",
      "/assets/core/log.js",
      "/assets/utils/fmt.js"
    ],
    "loader": false,
    "ssr": false
  },
  {
    "pattern": "/blog/:slug",
    "html": "/blog/[slug].html",
    "modules": [
      "/assets/routes/blog/_slug_.js",
      "/assets/lib/components/counter/counter.js",
      "/assets/lib/state/cart.js",
      "/assets/core/router.js",
      "/assets/core/log.js"
    ],
    "loader": true,
    "ssr": true
  },
  {
    "pattern": "/shop",
    "html": "/shop/index.html",
    "modules": [
      "/assets/lib/components/counter/counter.js",
      "/assets/lib/state/cart.js",
      "/assets/core/router.js",
      "/assets/core/log.js"
    ],
    "loader": false,
    "ssr": false
  },
  {
    "pattern": "/shop/:id",
    "html": "/shop/[id].html",
    "modules": [
      "/assets/routes/shop/_id_.js",
      "/assets/lib/components/counter/counter.js",
      "/assets/lib/state/cart.js",
      "/assets/core/router.js",
      "/assets/core/log.js"
    ],
    "loader": true,
    "ssr": false
  }
]